# Backend Configuration
PORT=5000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Security
ALLOWED_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=256kb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
TOKEN_STORE=firestore

# AI Service
AI_SERVICE_URL=http://localhost:5001

# Firebase Admin
# Place your aivestor-firebase-adminsdk.json in the project root
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Onboarding defaults
ONBOARDING_TICKERS=SPY,QQQ,VTI,VXUS,BND

# Yahoo/yfinance-style market data pacing
# yfinance does not publish a fixed Yahoo quota; its docs recommend caching plus
# conservative rate limiting. Default below mirrors their example: 2 requests / 5s.
FINNHUB_API_KEY=your-finnhub-api-key
FINNHUB_WEBSOCKET_SECRET=your-finnhub-websocket-token-or-api-key
FINNHUB_RATE_LIMIT_REQUESTS=55
FINNHUB_RATE_LIMIT_WINDOW_MS=60000
FINNHUB_RATE_LIMIT_COOLDOWN_MS=60000
MARKET_DATA_ENABLE_YAHOO_FALLBACK=false
MARKET_DATA_CACHE_TTL_MS=30000
MARKET_DATA_STALE_TTL_MS=300000
MARKET_DATA_TIMEOUT_MS=15000
MARKET_FETCH_MAX_MS=25000
MARKET_CHART_FALLBACK_SYMBOL_LIMIT=8
MARKET_HTTP_MAX_AGE_SECONDS=15
MARKET_HTTP_STALE_SECONDS=60
YAHOO_RATE_LIMIT_REQUESTS=2
YAHOO_RATE_LIMIT_WINDOW_MS=5000
YAHOO_RATE_LIMIT_COOLDOWN_MS=60000
